# Required variables, by name only. Real values are never committed.
# Where each one lives:
#   [worker]  Cloudflare Worker secret:   cd web && npx wrangler secret put NAME
#   [github]  repository Actions secret:  Settings > Secrets and variables > Actions
#   [local]   only on the machine that builds or deploys

# GitHub token the counter uses to dispatch the engine (Worker secret name: GITHUB_TOKEN). [worker]
GITHUB_PAT=
# Cloudflare account, to deploy the Worker. [local]
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Anti-bot check: the sitekey is public and printed on the page [local, at build];
# the secret never is [worker]. Without the secret the counter fails closed.
# For local builds, Cloudflare publishes test keys: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
# Shared secret between the counter and the engine. [worker] and [github]
ENGINE_SECRET=
# Owner key for the private archive at /archive, separate from the engine's. [worker]
OWNER_KEY=
# The gate password. Changing it ends every open session. [worker]
SITE_PASSWORD=
# Random secret that signs the gate tickets together with the password. [worker]
TICKET_KEY=
# Only in web/.dev.vars (never on a deployed Worker): LOCAL_DEV=true lets the
# local counter accept parts without the Cloudflare human check.
# Used by web/deploy.sh to prove the live site after a deploy. [local]
SITE_ORIGIN=
