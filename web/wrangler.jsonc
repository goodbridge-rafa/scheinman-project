{
  // The counter: one Worker serving both the site's pages and its API, so
  // there is one deploy, one origin and no cross-origin hop between them.
  "name": "scheinman-counter",
  "main": "src/worker.mjs",
  "compatibility_date": "2024-11-01",
  // run_worker_first: without it Cloudflare serves the pages BEFORE the Worker,
  // so the password gate protected the API and left every page wide open.
  // Found live on 2026-09-01, minutes after the gate was first deployed.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  // The job's files and the daily limits. 
  "kv_namespaces": [{ "binding": "JOBS", "id": "<your-kv-namespace-id>" }],
  // The job's state: one place per job, read-after-write. KV served a finished
  // job as "queued" for up to a minute in the first live run; see job_state.mjs.
  "durable_objects": {
    "bindings": [
      { "name": "JOB_STATE", "class_name": "JobState" },
      // The door's attempt counter: one object per visitor and hour, so ten
      // guesses sent at once are counted as ten (see gate_counter.mjs).
      { "name": "GATE_COUNT", "class_name": "GateCounter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["JobState"] },
    { "tag": "v2", "new_sqlite_classes": ["GateCounter"] }
  ],
  "vars": {
    "ENGINE_REPO": "<owner>/<repo>",
    // Where the engine calls back. Configuration, never the incoming request:
    // that call carries the engine secret.
    "SITE_ORIGIN": "https://scheinman.example.com"
  },
  // The counter watches itself every half hour and rings through the alert
  // workflow when a job died or stalled. GitHub's scheduled runs are best
  // effort (measured 2026-09-03), so the fast alarm lives here; 
  "triggers": { "crons": ["*/30 * * * *"] },
  "observability": { "enabled": true }
}
